<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- 顶栏：标题 + 语言（设置已移入连接状态行） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_dark"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/lang_switch"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 头部信息区：紧凑排列，内容过多时可滚动；占 1 份高度 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <!-- 业务说明（默认收起） -->
            <LinearLayout
                android:id="@+id/rulesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="9dp">

                <LinearLayout
                    android:id="@+id/rulesHead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/rules_title"
                        android:textColor="@color/orange"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRulesToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rules_expand"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRulesBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/rules_body"
                    android:textColor="#B0B0B0"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 任务/连接状态卡（紧凑三行布局） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="6dp"
                android:padding="9dp">

                <!-- 第一行：连接状态 + 设备号 + 设置 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/dotNet"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/dot_gray" />

                    <TextView
                        android:id="@+id/tvNet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/net_offline"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDeviceNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/device_none"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_dark"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/btn_settings"
                        android:textColor="#DDDDDD"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 第二行：任务状态 + 扫码加入任务 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="7dp">

                    <TextView
                        android:id="@+id/tvTask"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="@string/task_none"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnJoin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_btn_blue"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/btn_scan_join"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 快照 + UHF 模块信息（一行） -->
                <TextView
                    android:id="@+id/tvSnapshot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:singleLine="true"
                    android:text="@string/snapshot_none"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvUhf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:text="@string/uhf_none"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <!-- 第三行：下载库存 + 开始/停止扫描 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/btnDownload"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:gravity="center"
                        android:text="@string/btn_download"
                        android:textColor="#DDDDDD"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnTrigger"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_btn_green"
                        android:gravity="center"
                        android:text="@string/trigger_btn"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 操作提示（一行小字，无 UHF 的手机上点按开摄像头） -->
                <TextView
                    android:id="@+id/tvTriggerHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/trigger_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- 扳机诊断行：显示最近一次硬件触发事件来源，方便适配不同固件 -->
                <TextView
                    android:id="@+id/tvDiag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:text="@string/diag_none"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 高价值提醒 -->
            <TextView
                android:id="@+id/tvHvAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_orange"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:textColor="#FFE0B2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 统计 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:weightSum="4">

                <LinearLayout style="@style/HomeStat">
                    <TextView android:id="@+id/statSelf" style="@style/HomeStatNum" android:textColor="@color/green" />
                    <TextView style="@style/HomeStatLabel" android:text="@string/stat_self" />
                </LinearLayout>
                <LinearLayout style="@style/HomeStat">
                    <TextView android:id="@+id/statAbnormal" style="@style/HomeStatNum" android:textColor="@color/red" />
                    <TextView style="@style/HomeStatLabel" android:text="@string/stat_abnormal" />
                </LinearLayout>
                <LinearLayout style="@style/HomeStat">
                    <TextView android:id="@+id/statGlobal" style="@style/HomeStatNum" android:textColor="@color/blue" />
                    <TextView style="@style/HomeStatLabel" android:text="@string/stat_global" />
                </LinearLayout>
                <LinearLayout style="@style/HomeStat">
                    <TextView android:id="@+id/statBook" style="@style/HomeStatNum" android:textColor="@color/text_primary" />
                    <TextView style="@style/HomeStatLabel" android:text="@string/stat_book" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Tab（固定） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:padding="3dp">

        <TextView
            android:id="@+id/tabStore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="@string/tab_store"
            android:textColor="@color/green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabAbnormal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="@string/tab_abnormal"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- EPC 明细列表：占 1.5 份高度，区域内上下滑动 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:layout_marginTop="4dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_store"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
