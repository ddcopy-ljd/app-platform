<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_dark"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:text="@string/lang_switch"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_dark"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:text="@string/btn_settings"
            android:textColor="#DDDDDD"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <!-- 规则折叠卡 -->
            <LinearLayout
                android:id="@+id/rulesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/rulesHead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/rules_title"
                        android:textColor="@color/orange"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRulesToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rules_expand"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRulesBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/rules_body"
                    android:textColor="#B0B0B0"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 任务/连接状态卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginTop="10dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/dotNet"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/dot_gray" />

                    <TextView
                        android:id="@+id/tvNet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/net_offline"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDeviceNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_none"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/task_none"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSnapshot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/snapshot_none"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/btnJoin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_blue"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:text="@string/btn_scan_join"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnDownload"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_btn_dark"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:text="@string/btn_download"
                        android:textColor="#DDDDDD"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 高价值提醒 -->
            <TextView
                android:id="@+id/tvHvAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/badge_orange"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:textColor="#FFE0B2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 统计 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:weightSum="4">

                <LinearLayout style="@style/HomeStat">
                    <TextView android:id="@+id/statSelf" style="@style/HomeStatNum" android:textColor="@color/green" />
                    <TextView style="@style/HomeStatLabel" android:text="@string/stat_self" />
                </LinearLayout>
                <LinearLayout style="@style/HomeStat">
                    <TextView android:id="@+id/statAbnormal" style="@style/HomeStatNum" android:textColor="@color/red" />
                    <TextView style="@style/HomeStatLabel" android:text="@string/stat_abnormal" />
                </LinearLayout>
                <LinearLayout style="@style/HomeStat">
                    <TextView android:id="@+id/statGlobal" style="@style/HomeStatNum" android:textColor="@color/blue" />
                    <TextView style="@style/HomeStatLabel" android:text="@string/stat_global" />
                </LinearLayout>
                <LinearLayout style="@style/HomeStat">
                    <TextView android:id="@+id/statBook" style="@style/HomeStatNum" android:textColor="@color/text_primary" />
                    <TextView style="@style/HomeStatLabel" android:text="@string/stat_book" />
                </LinearLayout>
            </LinearLayout>

            <!-- 控制按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_green"
                    android:gravity="center"
                    android:paddingVertical="13dp"
                    android:text="@string/btn_start"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPause"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_dark"
                    android:gravity="center"
                    android:paddingVertical="13dp"
                    android:text="@string/btn_pause"
                    android:textColor="#AAAAAA"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnResume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_blue"
                    android:gravity="center"
                    android:paddingVertical="13dp"
                    android:text="@string/btn_resume"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnFinish"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_red"
                    android:gravity="center"
                    android:paddingVertical="13dp"
                    android:text="@string/btn_finish"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabStore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="@string/tab_store"
                    android:textColor="@color/green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabAbnormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="9dp"
                    android:text="@string/tab_abnormal"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 明细列表（固定底部区域） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingBottom="10dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_store"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
