<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- 顶栏（与设置页一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/btnSaleBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="←"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sale_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSalePower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_dark"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:textColor="@color/green"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="20dp">

            <!-- 商品识别 -->
            <TextView style="@style/StGroup" android:text="@string/sc_scan_title" />
            <LinearLayout style="@style/StCard" android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnScanBarcode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_blue"
                        android:gravity="center"
                        android:paddingVertical="11dp"
                        android:text="@string/sc_barcode"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnScanQr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:gravity="center"
                        android:paddingVertical="11dp"
                        android:text="@string/sc_qrcode"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnScanEpc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_green"
                        android:gravity="center"
                        android:paddingVertical="11dp"
                        android:text="@string/sc_epc"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvScanHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/sc_scanning"
                    android:textColor="@color/green"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/sc_scan_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 识别到的商品 -->
            <TextView style="@style/StGroup" android:text="@string/sc_group_item" />
            <LinearLayout style="@style/StCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivProduct"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_input"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProdEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sc_prod_empty"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvProdCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvProdName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvProdPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/green"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 出单信息 -->
            <TextView style="@style/StGroup" android:text="@string/sc_group_bill" />
            <LinearLayout style="@style/StCard" android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCustomer"
                        style="@style/StInput"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/sc_customer"
                        android:imeOptions="actionNext"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/etPhone"
                        style="@style/StInput"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/sc_phone"
                        android:inputType="phone"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    style="@style/StLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/sc_product" />
                <EditText
                    android:id="@+id/etProduct"
                    style="@style/StInput"
                    android:hint="@string/sc_product_hint"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etAmount"
                        style="@style/StInput"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/sc_amount"
                        android:inputType="numberDecimal"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/etPaid"
                        style="@style/StInput"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/sc_paid"
                        android:inputType="numberDecimal"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    style="@style/StLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/sc_pay" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipCash"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_green"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:text="@string/pay_cash"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipWechat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:text="@string/pay_wechat"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:text="@string/pay_card"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipTransfer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_dark"
                        android:gravity="center"
                        android:paddingVertical="9dp"
                        android:text="@string/pay_transfer"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    style="@style/StLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/sc_date" />
                <EditText
                    android:id="@+id/etDate"
                    style="@style/StInput"
                    android:hint="@string/sc_date"
                    android:inputType="date"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_btn_green"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:text="@string/sc_submit"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
