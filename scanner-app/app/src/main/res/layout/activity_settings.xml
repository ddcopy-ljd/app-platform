<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="←"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_green"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="@string/btn_save"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="24dp">

            <!-- 服务端 -->
            <TextView style="@style/StGroup" android:text="@string/st_group_server" />
            <LinearLayout style="@style/StCard" android:orientation="vertical">
                <TextView
                    style="@style/StLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/server_url" />
                <EditText
                    android:id="@+id/stUrl"
                    style="@style/StInput"
                    android:layout_marginTop="6dp"
                    android:hint="@string/server_url_hint"
                    android:inputType="textUri"
                    android:singleLine="true" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/st_pull_interval"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/stPullVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/green"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/stPull"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="115"
                    android:progressTint="@color/green"
                    android:thumbTint="@color/green" />
            </LinearLayout>

            <!-- RFID 参数 -->
            <TextView style="@style/StGroup" android:text="@string/st_group_rfid" />
            <LinearLayout style="@style/StCard" android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/st_power"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/stPowerVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/green"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/stPower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="25"
                    android:progressTint="@color/green"
                    android:thumbTint="@color/green" />

                <TextView style="@style/StLabel" android:text="@string/st_trigger" />
                <Spinner android:id="@+id/stTriggerMode" style="@style/StSpinner"
                    android:entries="@array/trigger_modes" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/st_trigger_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <TextView style="@style/StLabel" android:text="@string/st_region" />
                <Spinner android:id="@+id/stRegion" style="@style/StSpinner"
                    android:entries="@array/regions" />

                <TextView style="@style/StLabel" android:text="@string/st_session" />
                <Spinner android:id="@+id/stSession" style="@style/StSpinner"
                    android:entries="@array/sessions" />

                <TextView style="@style/StLabel" android:text="@string/st_qvalue" />
                <Spinner android:id="@+id/stQValue" style="@style/StSpinner"
                    android:entries="@array/qvalues" />

                <LinearLayout style="@style/StSwitch">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/StSwitchLabel" android:text="@string/st_rssi_on" />
                        <TextView style="@style/StSwitchSub" android:text="@string/st_rssi_on_sub" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/stRssiEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/st_rssi_threshold"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/stRssiVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/green"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/stRssiThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="60"
                    android:progressTint="@color/green"
                    android:thumbTint="@color/green" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/st_rssi_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 盘点设置 -->
            <TextView style="@style/StGroup" android:text="@string/st_group_count" />
            <LinearLayout style="@style/StCard" android:orientation="vertical">
                <LinearLayout style="@style/StSwitch">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/StSwitchLabel" android:text="@string/st_dedup" />
                        <TextView style="@style/StSwitchSub" android:text="@string/st_dedup_sub" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/stDedup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/StSwitch">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/StSwitchLabel" android:text="@string/st_hv" />
                        <TextView style="@style/StSwitchSub" android:text="@string/st_hv_sub" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/stHvRemind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout style="@style/StSwitch">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/StSwitchLabel" android:text="@string/st_vibrate" />
                        <TextView style="@style/StSwitchSub" android:text="@string/st_vibrate_sub" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/stVibrate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- 设备信息 -->
            <TextView style="@style/StGroup" android:text="@string/st_group_device" />
            <LinearLayout style="@style/StCard" android:orientation="vertical">
                <LinearLayout style="@style/StInfoRow">
                    <TextView style="@style/StInfoLabel" android:text="@string/st_dev_model" />
                    <TextView style="@style/StInfoValue" android:text="成为 C27" />
                </LinearLayout>
                <LinearLayout style="@style/StInfoRow">
                    <TextView style="@style/StInfoLabel" android:text="@string/st_dev_id" />
                    <TextView
                        android:id="@+id/stDeviceId"
                        style="@style/StInfoValue" />
                </LinearLayout>
                <LinearLayout style="@style/StInfoRow">
                    <TextView style="@style/StInfoLabel" android:text="@string/st_sdk_ver" />
                    <TextView android:id="@+id/stSdkVer" style="@style/StInfoValue" />
                </LinearLayout>
                <LinearLayout style="@style/StInfoRow">
                    <TextView style="@style/StInfoLabel" android:text="@string/st_fw_ver" />
                    <TextView android:id="@+id/stFwVer" style="@style/StInfoValue" />
                </LinearLayout>
                <TextView
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_btn_dark"
                    android:gravity="center"
                    android:paddingVertical="11dp"
                    android:text="@string/st_reset"
                    android:textColor="#EF9A9A"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
